<UserControl x:Class="CalculatorMateriale.Views.ClientiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="{StaticResource CanvasBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Gestionare clienți" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Adaugă, editează și caută clienții din baza de date."
                       Style="{StaticResource SubtitleTextBlockStyle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="Adaugă client" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0" Click="AddClientButton_Click"/>
                <Button Grid.Column="1" Content="Editează" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0" Click="EditClientButton_Click"/>
                <Button Grid.Column="2" Content="Șterge" Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,0,18,0" Click="DeleteClientButton_Click"/>
                <TextBox x:Name="SearchTextBox" Grid.Column="3" Height="36" Style="{StaticResource DefaultTextBoxStyle}"
                         Margin="0,0,10,0"/>
                <Button Grid.Column="4" Content="Caută" Style="{StaticResource SecondaryButtonStyle}"
                        Click="SearchClientButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <DataGrid x:Name="ClientiDataGrid"
                          AutoGenerateColumns="False"
                          Style="{StaticResource DefaultDataGridStyle}"
                          ItemsSource="{Binding}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdClient}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Companie" Binding="{Binding Nume}" Width="250" IsReadOnly="True"/>
                        <DataGridTextColumn Header="CUI" Binding="{Binding CUI}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Localitate" Binding="{Binding Localitate}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Data înregistrării" Binding="{Binding DataInregistrare, StringFormat=dd/MM/yyyy}" Width="140" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Activ" Binding="{Binding Activ}" Width="70" IsReadOnly="False"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyStateMessage"
                           Text="Niciun client înregistrat. Adaugă un client pentru a începe."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{StaticResource MutedInkBrush}"
                           TextAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                Padding="14,10" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Total clienți:" Style="{StaticResource LabelTextBlockStyle}" Margin="0"/>
                <TextBlock x:Name="TotalClientsLabel" Text="0" Style="{StaticResource LabelTextBlockStyle}"
                           Foreground="{StaticResource PrimaryRedBrush}" FontWeight="Bold" Margin="6,0,18,0"/>
                <TextBlock Text="Selectat:" Style="{StaticResource LabelTextBlockStyle}" Margin="0"/>
                <TextBlock x:Name="SelectedClientLabel" Text="Niciun" Style="{StaticResource LabelTextBlockStyle}"
                           Foreground="{StaticResource PrimaryRedBrush}" FontWeight="Bold" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
