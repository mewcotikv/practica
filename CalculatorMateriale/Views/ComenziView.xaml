<UserControl x:Class="CalculatorMateriale.Views.ComenziView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource CanvasBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Gestionare comenzi" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Urmărește comenzile, livrările, statusurile și valorile facturabile."
                       Style="{StaticResource SubtitleTextBlockStyle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Height="36" Style="{StaticResource DefaultTextBoxStyle}"
                         Text="Căutare comenzi..."/>

                <ComboBox Grid.Column="1" x:Name="StatusFilter" Height="36" Margin="10,0,0,0"
                          Style="{StaticResource DefaultComboBoxStyle}">
                    <ComboBoxItem Content="Toate" IsSelected="True"/>
                    <ComboBoxItem Content="Nouă"/>
                    <ComboBoxItem Content="Confirmată"/>
                    <ComboBoxItem Content="Finalizată"/>
                </ComboBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock Text="Perioada" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <DatePicker x:Name="DateFilter" Height="36" Width="110"/>
                </StackPanel>

                <Button Grid.Column="4" Content="Comandă nouă" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,8,0" Click="NewOrderButton_Click"/>
                <Button Grid.Column="5" Content="Raport" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ReportButton_Click"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" x:Name="ComenziGrid" AutoGenerateColumns="False"
                  Style="{StaticResource DefaultDataGridStyle}" CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdComanda}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Client" Binding="{Binding Client.Nume}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Data comandă" Binding="{Binding DataComanda, StringFormat='dd.MM.yyyy'}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Data livrare" Binding="{Binding DataLivrare, StringFormat='dd.MM.yyyy'}" Width="120" IsReadOnly="False"/>
                <DataGridComboBoxColumn Header="Status" SelectedValueBinding="{Binding Status}" Width="125">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:String}">
                            <sys:String>Noua</sys:String>
                            <sys:String>Confirmata</sys:String>
                            <sys:String>Finalizata</sys:String>
                            <sys:String>Anulata</sys:String>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="IsDropDownOpen" Value="True"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="IsEnabled" Value="False"/>
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="Valoare (MDL)" Binding="{Binding ValoareTotala, StringFormat='F2'}" Width="125" IsReadOnly="False"/>
                <DataGridTextColumn Header="TVA (MDL)" Binding="{Binding TVA, StringFormat='F2'}" Width="105" IsReadOnly="False"/>
                <DataGridTemplateColumn Header="Acțiuni" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Status" Margin="2" Padding="8,4" FontSize="11"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="ChangeStatusButton_Click"/>
                                <Button Content="Edit" Margin="2" Padding="8,4" FontSize="11"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="EditOrderButton_Click"/>
                                <Button Content="Șterge" Margin="2" Padding="8,4" FontSize="11"
                                        Style="{StaticResource OutlineButtonStyle}" Click="DeleteOrderButton_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock x:Name="StatusBarText" Text="Gata" Foreground="{StaticResource MutedInkBrush}" FontSize="12"/>
                <TextBlock x:Name="RecordCountText" Text="Total: 0 comenzi" Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
