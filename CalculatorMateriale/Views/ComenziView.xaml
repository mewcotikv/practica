<UserControl x:Class="CalculatorMateriale.Views.ComenziView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource CanvasBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Gestionare comenzi" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Urmărește comenzile, livrările, statusurile și valorile facturabile."
                       Style="{StaticResource SubtitleTextBlockStyle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" Height="36" Style="{StaticResource DefaultTextBoxStyle}"
                             TextChanged="Filter_Changed"/>

                    <ComboBox Grid.Column="1" x:Name="StatusFilter" Height="36" Margin="10,0,0,0"
                              Style="{StaticResource DefaultComboBoxStyle}" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Toate" Tag="" IsSelected="True"/>
                        <ComboBoxItem Content="Noua" Tag="Noua"/>
                        <ComboBoxItem Content="Confirmata" Tag="Confirmata"/>
                        <ComboBoxItem Content="Finalizata" Tag="Finalizata"/>
                        <ComboBoxItem Content="Anulata" Tag="Anulata"/>
                    </ComboBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="Data" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <DatePicker x:Name="DateFilter" Height="36" Width="110" SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="Reset" Style="{StaticResource OutlineButtonStyle}"
                            Margin="10,0,0,0" Click="ResetFiltersButton_Click"/>
                    <Button Grid.Column="6" Content="Raport" Style="{StaticResource SecondaryButtonStyle}"
                            Click="ReportButton_Click"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ClientCombo" Height="36" Margin="0,0,8,0"
                              DisplayMemberPath="Nume" SelectedValuePath="IdClient"
                              Style="{StaticResource DefaultComboBoxStyle}"/>
                    <TextBox x:Name="ValoareInput" Grid.Column="1" Height="36" Margin="0,0,8,0"
                             Style="{StaticResource DefaultTextBoxStyle}"/>
                    <TextBox x:Name="TvaInput" Grid.Column="2" Height="36" Margin="0,0,8,0"
                             Style="{StaticResource DefaultTextBoxStyle}"/>
                    <DatePicker x:Name="DataLivrareInput" Grid.Column="3" Height="36" Margin="0,0,8,0"/>
                    <ComboBox x:Name="OrderStatusInput" Grid.Column="4" Height="36" Margin="0,0,8,0"
                              Style="{StaticResource DefaultComboBoxStyle}">
                        <ComboBoxItem Content="Noua" IsSelected="True"/>
                        <ComboBoxItem Content="Confirmata"/>
                        <ComboBoxItem Content="Finalizata"/>
                        <ComboBoxItem Content="Anulata"/>
                    </ComboBox>
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button Content="Salvează" Width="92" Height="36" Margin="0,0,6,0"
                                Style="{StaticResource PrimaryButtonStyle}" Click="NewOrderButton_Click"/>
                        <Button Content="Actualizează" Width="112" Height="36"
                                Style="{StaticResource SecondaryButtonStyle}" Click="UpdateOrderButton_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ComenziGrid" AutoGenerateColumns="False"
                      Style="{StaticResource DefaultDataGridStyle}" CanUserAddRows="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionChanged="ComenziGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdComanda}" Width="55" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Client" Binding="{Binding Client.Nume}" Width="180" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Data comandă" Binding="{Binding DataComanda, StringFormat='dd.MM.yyyy'}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Livrare" Binding="{Binding DataLivrare, StringFormat='dd.MM.yyyy'}" Width="95" IsReadOnly="False"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Valoare" Binding="{Binding ValoareTotala, StringFormat='F2'}" Width="95" IsReadOnly="False"/>
                    <DataGridTextColumn Header="TVA" Binding="{Binding TVA, StringFormat='F2'}" Width="80" IsReadOnly="False"/>
                    <DataGridTemplateColumn Header="Acțiuni" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Status" Margin="2" Padding="8,4" FontSize="11"
                                            Style="{StaticResource PrimaryButtonStyle}" Click="ChangeStatusButton_Click"/>
                                    <Button Content="Edit" Margin="2" Padding="8,4" FontSize="11"
                                            Style="{StaticResource SecondaryButtonStyle}" Click="EditOrderButton_Click"/>
                                    <Button Content="Șterge" Margin="2" Padding="8,4" FontSize="11"
                                            Style="{StaticResource OutlineButtonStyle}" Click="DeleteOrderButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PozitiiTitle" Text="Poziții comandă" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="MaterialCombo" Height="34" Margin="0,0,8,8"
                                  SelectedValuePath="IdMaterial"
                                  Style="{StaticResource DefaultComboBoxStyle}"
                                  SelectionChanged="MaterialCombo_SelectionChanged"/>
                        <TextBox x:Name="CantitateInput" Grid.Column="1" Height="34" Margin="0,0,8,8"
                                 Style="{StaticResource DefaultTextBoxStyle}"/>
                        <TextBox x:Name="PretPozitieInput" Grid.Column="2" Height="34" Margin="0,0,8,8"
                                 Style="{StaticResource DefaultTextBoxStyle}"/>
                        <Button Grid.Column="3" Content="Adaugă" Height="34" Width="82"
                                Style="{StaticResource PrimaryButtonStyle}" Click="AddPositionButton_Click"/>

                        <Button Grid.Row="1" Grid.Column="3" Content="Șterge" Height="34" Width="82"
                                Style="{StaticResource OutlineButtonStyle}" Click="DeletePositionButton_Click"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="Cantitate și preț unitar pentru materialul selectat"
                                   Foreground="{StaticResource MutedInkBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid Grid.Row="2" x:Name="PozitiiGrid" AutoGenerateColumns="False"
                              Style="{StaticResource DefaultDataGridStyle}" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Material" Binding="{Binding Material.Denumire}" Width="*"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantitate, StringFormat='F2'}" Width="70"/>
                            <DataGridTextColumn Header="Preț" Binding="{Binding PretUnitar, StringFormat='F2'}" Width="75"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding PretTotal, StringFormat='F2'}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock x:Name="StatusBarText" Text="Gata" Foreground="{StaticResource MutedInkBrush}" FontSize="12"/>
                <TextBlock x:Name="RecordCountText" Text="Total: 0 comenzi" Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
